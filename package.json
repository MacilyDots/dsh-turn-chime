{
  "name": "dsh-turn-chime",
  "version": "0.2.0",
  "description": "Conversation-completion chime for DeepSeek Harness: plays a short synthesized sound when a user-initiated task actually finishes — not when it is interrupted — with a settings panel for voice and volume, plus an optional Windows taskbar unread-count badge.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "notification",
    "sound",
    "chime"
  ],
  "license": "MIT",
  "author": "MacilyDots",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MacilyDots/dsh-turn-chime.git"
  },
  "homepage": "https://github.com/MacilyDots/dsh-turn-chime#readme",
  "bugs": {
    "url": "https://github.com/MacilyDots/dsh-turn-chime/issues"
  },
  "scripts": {
    "test": "node test/test-logic.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}

